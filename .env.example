# Project Two (codename) — Environment example
# Copy to .env and fill in, or leave blank to run in demo mode.

# Supabase (production backend — provision your own project at supabase.com)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Notes:
# - Never put the service-role key here. Only the anon key belongs in a client.
# - With both values set, the app uses the real backend (SupabaseRepository).
# - With either blank, the app runs the interactive demo (DemoRepository).
